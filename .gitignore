@'
# Python
__pycache__/
*.py[cod]
*.pyo

# Entornos virtuales
.venv/
venv/
env/

# Bases de datos y datos personales
datos/*.db
datos/*.sqlite
datos/*.sqlite3
datos/*.json
datos/backups/

# Configuración privada
.env
.env.*

